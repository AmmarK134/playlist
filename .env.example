# Copy this file to .env.local and fill in the values:
#   cp .env.example .env.local
# .env.local is gitignored. Never commit real secrets.

# ---------------------------------------------------------------------------
# NextAuth
# ---------------------------------------------------------------------------
# The base URL the app is served from. NextAuth builds the Spotify OAuth
# callback from this: <NEXTAUTH_URL>/api/auth/callback/spotify
#
# Local dev: use 127.0.0.1, NOT localhost. Spotify no longer accepts
# "localhost" redirect URIs, only the loopback IP. You must also open the app
# in the browser at http://127.0.0.1:3000 (session cookies are per-host, so
# mixing localhost and 127.0.0.1 breaks login).
#
# Production (Vercel): set this to your deployed URL, e.g.
# https://your-app.vercel.app
NEXTAUTH_URL=http://127.0.0.1:3000

# Random string used to sign/encrypt the session JWT. Generate one with:
#   openssl rand -base64 32
# Use a different value for production than for local dev.
NEXTAUTH_SECRET=

# ---------------------------------------------------------------------------
# Spotify OAuth  (https://developer.spotify.com/dashboard)
# ---------------------------------------------------------------------------
# Create an app, select "Web API", then copy Client ID / Client Secret from
# the app's Settings page.
#
# In the same Settings page, add these Redirect URIs (must match exactly):
#   http://127.0.0.1:3000/api/auth/callback/spotify          (local dev)
#   https://your-app.vercel.app/api/auth/callback/spotify    (production)
#
# While the Spotify app is in "Development mode", Spotify API access is limited
# to accounts listed under User Management, so add your own account's email
# there. Development mode also requires the app owner to have Premium.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# OpenAI  (https://platform.openai.com/api-keys)
# ---------------------------------------------------------------------------
# Used by app/api/ai/chat and app/api/ai/create-playlist. The key needs billing
# enabled and access to the configured model. Spotify connection and the public
# preview do not require this key.
OPENAI_API_KEY=

# Optional: override the default generation model.
OPENAI_MODEL=gpt-4.1-mini
